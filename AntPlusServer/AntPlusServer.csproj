<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.84.0" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.Seq" Version="9.1.0" />
    <PackageReference Include="SmallEarthTech.AntUsbStick" Version="4.1.9" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Protos\" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\AntGrpc.Shared\ant_channel.proto" GrpcServices="Server">
      <Link>Protos\ant_channel.proto</Link>
    </Protobuf>
    <Protobuf Include="..\AntGrpc.Shared\ant_configuration.proto" GrpcServices="Server">
      <Link>Protos\ant_configuration.proto</Link>
    </Protobuf>
    <Protobuf Include="..\AntGrpc.Shared\ant_control.proto" GrpcServices="Server">
      <Link>Protos\ant_control.proto</Link>
    </Protobuf>
    <Protobuf Include="..\AntGrpc.Shared\ant_crypto.proto" GrpcServices="Server">
      <Link>Protos\ant_crypto.proto</Link>
    </Protobuf>
    <Protobuf Include="..\AntGrpc.Shared\ant_radio.proto" GrpcServices="Server">
      <Link>Protos\ant_radio.proto</Link>
    </Protobuf>
  </ItemGroup>

</Project>
